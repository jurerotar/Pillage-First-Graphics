{
  "name": "@pillage-first/graphics",
  "version": "0.4.0-rc8",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "sideEffects": [
    "./dist/icons.css"
  ],
  "description": "Pillage-First Graphics Library provides graphical assets for the game Pillage First! (Ask Questions Later). This library includes SVG-based graphics, as well as organized image packs.",
  "author": "Jure Rotar <hello@jurerotar.com>",
  "homepage": "https://github.com/jurerotar/Pillage-First-Graphics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurerotar/Pillage-First-Graphics.git"
  },
  "keywords": [],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./icons.css": "./dist/icons.css"
  },
  "module": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node ./scripts/watch.ts",
    "build": "tsdown",
    "lint:check": "npx @biomejs/biome lint",
    "lint": "npx @biomejs/biome lint --fix",
    "format:check": "npx @biomejs/biome format",
    "format": "npx @biomejs/biome format --write",
    "type-check": "tsc --noEmit",
    "publint": "publint",
    "attw": "attw --pack --profile esm-only --exclude-entrypoints ./icons.css",
    "test": "vitest",
    "prepublishOnly": "npm run build",
    "release": "node ./scripts/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chokidar": "5.0.0",
    "react": "19.3.0",
    "sass": "1.105.1",
    "sharp": "0.35.4",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "publint": "0.3.25",
    "@arethetypeswrong/cli": "0.18.5"
  },
  "dependencies": {
    "moderndash": "4.0.2"
  },
  "peerDependency": {
    "react": ">= 16",
    "react-dom": ">= 16"
  }
}
